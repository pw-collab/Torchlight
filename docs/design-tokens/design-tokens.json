  "font": {
    "heading": {
      "$value": "'Germania One', Georgia, serif",
      "$type": "fontFamily",
      "$description": "Titles from 16px up. Single weight, size is the hierarchy lever."
    },
    "numeral": {
      "$value": "'Germania One', Georgia, serif",
      "$type": "fontFamily",
      "$description": "Inked numerals: modifiers, HP, AC"
    },
    "body": {
      "$value": "'Libre Franklin', sans-serif",
      "$type": "fontFamily",
      "$description": "Running text (variable 100-900)"
    },
    "mono": {
      "$value": "'Libre Franklin', sans-serif",
      "$type": "fontFamily",
      "$description": "Labels and metadata under 16px. Not a monospace."
    },
    "stat": {
      "$value": "'Bricolage Grotesque', sans-serif",
      "$type": "fontFamily",
      "$description": "Clock and nav readouts (wght 500-800, opsz 12-96)"
    }
  },
  "typography": {
    "display-xl": {
      "fontFamily": "{font.heading}",
      "fontSize": "48px",
      "lineHeight": 1.2
    },
    "display-lg": {

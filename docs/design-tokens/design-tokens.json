      "fontSize": "16px",
      "lineHeight": 1.2,
      "textTransform": "uppercase"
    },
    "button": {
      "fontFamily": "{font.mono}",
      "fontWeight": 700,
      "fontSize": "16px",
      "lineHeight": 1.2,
      "textTransform": "uppercase"
